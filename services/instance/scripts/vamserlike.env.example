# =========================================================
# Vamserlike EKS / Argo CD / CI/CD Bootstrap Environment
# 이 파일을 scripts/vamserlike.env 로 복사한 뒤 실제 값으로 수정해서 사용
# =========================================================

# ---------------------------------------------------------
# AWS / EKS 기본 설정
# ---------------------------------------------------------
AWS_REGION=ap-northeast-2
CLUSTER_NAME=eks-demo
NODEGROUP_NAME=vamserlike-node-group
VPC_CIDR=10.40.0.0/16
ECR_REPOSITORY=vamserlike-backend

# ---------------------------------------------------------
# Terraform 기본 인프라 Subnet Name
# main.tf에 정의된 tag:Name 값과 반드시 일치해야 함
# ---------------------------------------------------------
PUBLIC_SUBNET_2A_NAME=Public-Subnet-2a
PUBLIC_SUBNET_2C_NAME=Public-Subnet-2c
PRIVATE_SUBNET_2A_NAME=Private-Subnet-2a
PRIVATE_SUBNET_2C_NAME=Private-Subnet-2c

# ---------------------------------------------------------
# Cognito
# Terraform output 값으로 교체해서 사용
#
# 확인 명령어:
# terraform output -raw vamserlike_cognito_user_pool_id
# terraform output -raw vamserlike_cognito_app_client_id
# ---------------------------------------------------------
COGNITO_USER_POOL_ID=ap-northeast-2_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------
# MySQL / RDS Connection String
# 실제 DB 엔드포인트, DB명, 계정, 비밀번호로 수정
# 비밀번호에 특수문자가 있으면 전체를 작은따옴표로 감싸는 것을 권장
# ---------------------------------------------------------
MYSQL_CONNECTION_STRING='Server=your-rds-endpoint.ap-northeast-2.rds.amazonaws.com;Port=3306;Database=vamserlike;User=admin;Password=your-password;SslMode=Preferred;AllowPublicKeyRetrieval=True;'

# ---------------------------------------------------------
# Argo CD / Manifest Repo
# ---------------------------------------------------------
MANIFEST_REPO_URL=https://github.com/rlduddl/Vamserlike-k8s-manifests.git
MANIFEST_PATH=overlays/dev
ARGOCD_APP_NAME=vamserlike-backend

# ---------------------------------------------------------
# Monitoring / Grafana
#
# MONITORING_ENABLED=true 이면 bootstrap 실행 시
# monitoring namespace에 kube-prometheus-stack 설치
#
# 포함 구성:
# - Prometheus
# - Grafana
# - kube-state-metrics
# - node-exporter
#
# Grafana version은 bootstrap-vamserlike.sh에서 10.4.10으로 고정
# 팀원 Dashboard import 호환을 위해 버전 고정
# ---------------------------------------------------------
MONITORING_ENABLED=true
GRAFANA_ADMIN_PASSWORD=Vamserlike123!
GRAFANA_RELEASE_NAME=vamserlike-monitoring
GRAFANA_ADMIN_SECRET_NAME=vamserlike-grafana-admin

# ---------------------------------------------------------
# CloudWatch Logs
#
# aws-for-fluent-bit가 백엔드 Pod stdout 로그를
# CloudWatch Logs로 전송
#
# bootstrap에서 cloudWatchLogs.logKey=log 옵션을 사용하므로
# CloudWatch에는 Kubernetes metadata 전체 JSON이 아니라
# 백엔드 앱이 출력한 실제 log 필드만 저장됨
# ---------------------------------------------------------
BACKEND_LOG_GROUP_NAME=/ec2/vamserlike-backend

# ---------------------------------------------------------
# Cleanup Option
#
# 기본값 false:
# CloudWatch Log Group은 증빙/확인용으로 남겨둠
#
# 완전 삭제하려면 true로 변경
# ---------------------------------------------------------
DELETE_CLOUDWATCH_LOG_GROUP=false